# ============================================================
# FBRAH AI — ENVIRONMENT CONFIGURATION / إعدادات البيئة
# Copy this file to .env locally. Never commit the real .env.
# انسخ إلى .env محلياً. لا ترفع ملف .env الحقيقي إلى GitHub.
# ============================================================

# ---------------- GROQ ----------------
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Optional comma-separated valid Groq model IDs, ordered by preference.
# Add only model IDs available to your Groq account; fallback tries them when cloud fallback=1.
GROQ_MODELS=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ---------------- GOOGLE GEMINI ----------------
# One key shared by the configured Gemini models / مفتاح واحد للنماذج
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MODELS=gemini-3.8-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.6-flash,gemini-3.1-pro-preview

# ---------------- IMAGE GENERATION ----------------
FBRAH_IMAGE_GEN=1

# ---------------- OLLAMA / LOCAL AI ----------------
OLLAMA_BASE_URL=http://127.0.0.1:11434
FBRAH_DEFAULT_MODEL=qwen2.5:7b

# ---------------- LOCAL LIBRARY / OUTPUT ----------------
FBRAH_LAW_OFFICE_FOLDER=~/FBRAH_Law_Office
FBRAH_OUTPUT_FOLDER=~/FBRAH_Law_Office/Results

# ---------------- VECTOR RAG ----------------
FBRAH_VECTOR_BACKEND=auto
FBRAH_EMBED_MODEL=intfloat/multilingual-e5-small
FBRAH_RERANK_MODEL=BAAI/bge-reranker-base
FBRAH_AUTO_INDEX=0
# Model downloads are disabled unless explicitly enabled.
FBRAH_ALLOW_ONLINE_EMBED=0

# ---------------- FALLBACK POLICY ----------------
# Automatic fallback is enabled within each mode only; cross-mode fallback is forbidden.
# التحويل مفعّل داخل كل بيئة فقط؛ يمنع الانتقال بين المحلي والسحابي.
FBRAH_ALLOW_LOCAL_MODEL_FALLBACK=1
FBRAH_ALLOW_CLOUD_FALLBACK=1
# Cloud API read timeout in seconds (bounded in code to 10–60; default 30).
FBRAH_CLOUD_TIMEOUT=30

# ---------------- UPLOAD / OCR LIMITS ----------------
# Total request cap. OCR images have a stricter independent limit in code.
FBRAH_MAX_UPLOAD_MB=500
FBRAH_OCR_MAX_PAGES=200

# ---------------- SECURITY / HTTPS ----------------
# Set to 1 only when the app is actually served through HTTPS.
# فعّله فقط عند تشغيل التطبيق فعلياً عبر HTTPS.
FBRAH_HTTPS=0

# ---------------- PASSWORD RESET EMAIL ----------------
# Keep real SMTP credentials in local .env only.
FBRAH_SMTP_HOST=
FBRAH_SMTP_PORT=587
FBRAH_SMTP_USER=
FBRAH_SMTP_PASSWORD=
FBRAH_SMTP_FROM=
FBRAH_PUBLIC_BASE_URL=

FBRAH_DISABLE_LIVE_NEWS=0
FBRAH_FAULTHANDLER=0
