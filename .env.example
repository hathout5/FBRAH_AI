# ============================================
# FBRAH — ملف البيئة (.env)
# ضع هذا الملف بجانب app.py
# لا تشارك مفتاحك مع أحد
# ============================================

# مفتاح GROQ (من https://console.groq.com )
GROQ_API_KEY=

# نموذج GROQ
GROQ_MODEL=openai/gpt-oss-120b

# عنوان API (اتركه كما هو عادة)
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Ollama المحلي
OLLAMA_BASE_URL=http://127.0.0.1:11434
FBRAH_DEFAULT_MODEL=qwen2.5:7b

# مجلدات (اختياري)
# FBRAH_UPLOAD_FOLDER=C:\Users\hatho\Desktop\مكاتب محاماة
# FBRAH_OUTPUT_FOLDER=C:\Users\hatho\Desktop\مكاتب محاماة\النتائج

# Vector RAG: auto | chroma | qdrant | off
FBRAH_VECTOR_BACKEND=auto
FBRAH_EMBED_MODEL=intfloat/multilingual-e5-small
FBRAH_RERANK_MODEL=BAAI/bge-reranker-base

# أمان الجلسة (اختياري — يُولَّد تلقائياً إن تُرك فارغاً)
# FBRAH_SECRET_KEY=
